{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vacancyguard-phase2-collection-log-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["collection_event_id", "advertisement_id", "attempted_at", "collector_id", "input_type", "retrieval_status", "privacy_review_status"],
  "properties": {
    "collection_event_id": {"type": "string", "minLength": 1},
    "advertisement_id": {"type": "string", "minLength": 1},
    "attempted_at": {"type": "string", "format": "date-time"},
    "collector_id": {"type": "string", "minLength": 1},
    "input_type": {"enum": ["url", "pasted_text", "poster", "pdf"]},
    "submitted_source_url": {"type": ["string", "null"], "format": "uri"},
    "final_source_url": {"type": ["string", "null"], "format": "uri"},
    "retrieval_status": {"enum": ["available", "unavailable", "blocked", "redirected", "empty", "failed", "not_searched"]},
    "http_status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "extraction_status": {"enum": ["not_attempted", "content_extracted", "no_usable_content", "failed", "not_applicable"]},
    "failure_reason": {"type": ["string", "null"]},
    "snapshot_reference": {"type": ["string", "null"]},
    "privacy_review_status": {"enum": ["not_needed", "redacted", "pending_review"]}
  }
}
