{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "employer-sources-v1",
  "type": "object",
  "required": ["schema_version", "max_current_posting_age_days", "mappings"],
  "properties": {
    "schema_version": {"const": "employer-sources-v1"},
    "max_current_posting_age_days": {"type": "integer", "minimum": 1, "maximum": 3650},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["employer_id", "canonical_employer_name", "authorized_domain", "relationship_type", "verification_status", "verification_provenance", "last_verified_at"],
        "properties": {
          "employer_id": {"type": "string", "minLength": 1},
          "canonical_employer_name": {"type": "string", "minLength": 1},
          "authorized_domain": {"type": "string", "minLength": 3},
          "authorized_path_prefix": {"type": "string", "pattern": "^/"},
          "relationship_type": {"enum": ["employer_owned_official", "verified_employer_associated_ats"]},
          "verification_status": {"enum": ["verified", "unverified"]},
          "verification_provenance": {"type": "string", "minLength": 1},
          "last_verified_at": {"type": "string", "format": "date"},
          "notes": {"type": "string"}
        },
        "allOf": [
          {"if": {"properties": {"relationship_type": {"const": "verified_employer_associated_ats"}}}, "then": {"required": ["authorized_path_prefix"]}}
        ]
      }
    }
  }
}
